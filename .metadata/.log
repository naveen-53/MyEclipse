				ratinMaze(mat,r+i,c,ans);
			}
			if(c<mat.length-1 && mat[r][c+i]==1) {
				ratinMaze(mat,r,c+i,ans);
			}
		}
		ans[r][c]=0;
		return ans;
	}
	
	static boolean isSafe(int[][] path)

	public static void main(String[] args) {
		int[][] mat = {{2,1,0,0},{3,0,0,1},{0,1,0,1},{0,0,0,1}};
		
		int[][] ans = ratinMaze(mat,0,0,new int[mat.length][mat.length]);
		
		for(int i=0;i<ans.length;i++) {
