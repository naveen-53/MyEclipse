/*
 * Question Link - https://leetcode.com/problems/set-mismatch/description/
 */
public class SetMismatch_645 {
	
	static int[] mismatch(int[] a) {
		int i=0;
		while(i<a.length) {
			int correct = a[i]-1;
			if(a[i]!=a[correct]) {
				swap(a,i,correct);
			}
			else {
				i++;
			}
		}
	}
	static void swap(i)
	
	public static void main(String[] args) {
		int[] nums = {1,2,2,4};
		
	}
}

